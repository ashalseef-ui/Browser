{
  "manifest_version": 2,
  "name": "Volt Engine Bridge",
  "version": "1.0.0",
  "description": "Internal Volt Browser bridge for proxy routing, Kill Switch enforcement, Data Saver, and media discovery.",
  "browser_specific_settings": {
    "gecko": {
      "id": "volt-bridge@voltbrowser.app",
      "strict_min_version": "113.0"
    }
  },
  "permissions": [
    "proxy",
    "webRequest",
    "webRequestBlocking",
    "nativeMessaging",
    "geckoViewAddons",
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
